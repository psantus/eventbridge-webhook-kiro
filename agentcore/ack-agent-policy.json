{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "Logs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents",
        "logs:DescribeLogStreams"
      ],
      "Resource": "arn:aws:logs:${AWS_REGION}:${ACCOUNT_ID}:log-group:/aws/bedrock-agentcore/runtimes/*"
    },
    {
      "Sid": "Code",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::${CODE_BUCKET}/*"
    },
    {
      "Sid": "SignGitHubAppJwt",
      "Effect": "Allow",
      "Action": "kms:Sign",
      "Resource": "${GITHUB_APP_KMS_KEY_ARN}"
    }
  ]
}
