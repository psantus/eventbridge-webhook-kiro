{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PublishWebhookEvents",
      "Effect": "Allow",
      "Action": "events:PutWebhookEvents",
      "Resource": "${BUS_ARN}"
    },
    {
      "Sid": "ReadWebhookSecret",
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": "arn:aws:secretsmanager:${AWS_REGION}:${ACCOUNT_ID}:secret:events-webhook!*"
    }
  ]
}
